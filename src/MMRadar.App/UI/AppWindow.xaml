<Window x:Class="MMRadar.Standalone.AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MMRadar.UI"
        Title="MMRadar"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1A1B1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F4F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FFAAB0B7"/>
        <SolidColorBrush x:Key="AccentGold" Color="#FFE6C377"/>
        <SolidColorBrush x:Key="CardFill" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="Divider" Color="#1FFFFFFF"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF121417"/>
            <Setter Property="Background" Value="{StaticResource AccentGold}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Dark checkbox in the window's palette (the stock one is a bright white box) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4"
                                    Background="#1FFFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="M 3.2,7.4 L 6.2,10.2 L 11.6,4.6"
                                      Stroke="#FF121417" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGold}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#99FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tab switch -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="0,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16" Width="260">
        <!-- Two tabs instead of one long page -->
        <Border Background="{StaticResource CardFill}" CornerRadius="9" Padding="3">
            <UniformGrid Columns="2">
                <Button x:Name="TabGeneral" Style="{StaticResource TabButton}" Click="TabGeneral_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="General"/>
                        <Ellipse x:Name="UpdateDot" Width="6" Height="6" Fill="#FF34C286"
                                 Margin="6,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                 ToolTip="An update is available"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabPanel" Style="{StaticResource TabButton}" Click="TabPanel_Click" Content="Panel"/>
            </UniformGrid>
        </Border>

        <!-- Both pages share one cell; the hidden one still reserves its size,
             so the window keeps one height while switching tabs. -->
        <Grid Margin="0,14,0,0">
            <StackPanel x:Name="GeneralPage">
                <Border Background="{StaticResource CardFill}" CornerRadius="8" Padding="11,8" Margin="0,0,0,10">
                    <DockPanel>
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" DockPanel.Dock="Left"
                                 VerticalAlignment="Top" Margin="0,5,9,0" Fill="#FF8B949E"/>
                        <StackPanel>
                            <TextBlock x:Name="StatusTitle" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="StatusDetail" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- First run only -->
                <Border x:Name="WelcomeCard" Background="{StaticResource CardFill}" CornerRadius="8"
                        Padding="11,9" Margin="0,0,0,10" Visibility="Collapsed"
                        BorderBrush="#40E6C377" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="You're all set" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGold}"/>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="The panel appears by itself in every Battlegrounds match."/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Text="MMRadar lives in the system tray. If Windows hides the icon behind ^, drag it onto the taskbar."/>
                    </StackPanel>
                </Border>

                <!-- Update available -->
                <Border x:Name="UpdateCard" Background="{StaticResource CardFill}" CornerRadius="8"
                        Padding="11,9" Margin="0,0,0,10" Visibility="Collapsed"
                        BorderBrush="#5934C286" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="UpdateTitle" FontSize="12" FontWeight="SemiBold" Foreground="#FF34C286"/>
                        <TextBlock x:Name="UpdateDetail" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,3,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="Update now"
                                    Click="UpdateButton_Click"/>
                            <Button Style="{StaticResource LinkButton}" Content="What's new" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Click="WhatsNew_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="APP" FontSize="9.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}" Margin="2,4,0,7"/>
                <CheckBox x:Name="AutostartBox" Content="Start with Windows"
                          Checked="AutostartBox_Changed" Unchecked="AutostartBox_Changed"/>
                <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically"
                          Checked="AutoUpdateBox_Changed" Unchecked="AutoUpdateBox_Changed"/>

                <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                    <Button x:Name="CheckButton" Style="{StaticResource LinkButton}" Content="Check for updates"
                            Click="CheckButton_Click"/>
                    <TextBlock Text="  ·  " FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                    <Button Style="{StaticResource LinkButton}" Content="GitHub" Click="GitHub_Click"/>
                    <TextBlock Text="  ·  " FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                    <Button Style="{StaticResource LinkButton}" Content="Data folder" Click="DataFolder_Click"/>
                </StackPanel>
                <TextBlock x:Name="CheckResult" FontSize="11" Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap" Margin="2,5,0,0" Visibility="Collapsed"/>

                <TextBlock FontSize="10.5" Foreground="#FF7D848C" TextWrapping="Wrap" Margin="2,12,0,0"
                           Text="Closing this window keeps MMRadar in the tray."/>
            </StackPanel>

            <!-- The panel's look and position (shared with the plugin as-is) -->
            <ui:SettingsContent x:Name="Settings" VerticalAlignment="Top" Visibility="Hidden"/>
        </Grid>
    </StackPanel>
</Window>