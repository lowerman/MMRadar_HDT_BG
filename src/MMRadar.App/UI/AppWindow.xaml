<Window x:Class="MMRadar.Standalone.AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MMRadar"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1A1B1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F4F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FFAAB0B7"/>
        <SolidColorBrush x:Key="AccentGold" Color="#FFE6C377"/>
        <SolidColorBrush x:Key="CardFill" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="Divider" Color="#1FFFFFFF"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- One option of a compact segmented choice; the selected one gets a gold
             outline (set from code via BorderBrush). -->
        <Style x:Key="SegButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="0,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF121417"/>
            <Setter Property="Background" Value="{StaticResource AccentGold}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Dark checkbox in the window's palette (the stock one is a bright white box) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4"
                                    Background="#1FFFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="M 3.2,7.4 L 6.2,10.2 L 11.6,4.6"
                                      Stroke="#FF121417" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGold}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#99FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16" Width="284">
        <!-- Status + version -->
        <DockPanel Margin="2,0,0,12">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="11"
                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            <Ellipse x:Name="StatusDot" Width="7" Height="7" DockPanel.Dock="Left"
                     VerticalAlignment="Center" Margin="0,0,8,0" Fill="#FF8B949E"/>
            <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                <Run x:Name="StatusTitle" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                <Run x:Name="StatusDetail" Foreground="{StaticResource TextMuted}"/>
            </TextBlock>
        </DockPanel>

        <!-- First run only -->
        <Border x:Name="WelcomeCard" Background="{StaticResource CardFill}" CornerRadius="8"
                Padding="11,9" Margin="0,0,0,12" Visibility="Collapsed"
                BorderBrush="#40E6C377" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="You're all set" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentGold}"/>
                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="The panel appears by itself in Battlegrounds. MMRadar lives in the system tray — if Windows hides the icon behind ^, drag it onto the taskbar."/>
            </StackPanel>
        </Border>

        <!-- Update available -->
        <Border x:Name="UpdateCard" Background="{StaticResource CardFill}" CornerRadius="8"
                Padding="11,9" Margin="0,0,0,12" Visibility="Collapsed"
                BorderBrush="#5934C286" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="UpdateTitle" FontSize="12" FontWeight="SemiBold" Foreground="#FF34C286"/>
                <TextBlock x:Name="UpdateDetail" FontSize="11" Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap" Margin="0,3,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="Update now"
                            Click="UpdateButton_Click"/>
                    <Button Style="{StaticResource LinkButton}" Content="What's new" Margin="12,0,0,0"
                            VerticalAlignment="Center" Click="WhatsNew_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- PANEL: one compact row per setting -->
        <TextBlock Text="PANEL" Style="{StaticResource SectionLabel}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Theme" Style="{StaticResource RowLabel}"/>
            <UniformGrid Grid.Row="0" Grid.Column="1" Columns="3" Margin="0,0,-4,0">
                <Button x:Name="ThemeDark" Style="{StaticResource SegButton}" Content="Dark"
                        ToolTip="Solid near-black — maximum contrast" Click="ThemeDark_Click"/>
                <Button x:Name="ThemeNeutral" Style="{StaticResource SegButton}" Content="Neutral"
                        ToolTip="Neutral grey (default)" Click="ThemeNeutral_Click"/>
                <Button x:Name="ThemeWarm" Style="{StaticResource SegButton}" Content="Warm"
                        ToolTip="Warm tones" Click="ThemeWarm_Click"/>
            </UniformGrid>

            <TextBlock Grid.Row="2" Text="Order" Style="{StaticResource RowLabel}"/>
            <UniformGrid Grid.Row="2" Grid.Column="1" Columns="2" Margin="0,0,-4,0">
                <Button x:Name="SortDesc" Style="{StaticResource SegButton}" Content="Highest first"
                        Click="SortDesc_Click"/>
                <Button x:Name="SortAsc" Style="{StaticResource SegButton}" Content="Lowest first"
                        Click="SortAsc_Click"/>
            </UniformGrid>

            <TextBlock Grid.Row="4" Text="Avg colors" Style="{StaticResource RowLabel}"/>
            <UniformGrid Grid.Row="4" Grid.Column="1" Columns="3" Margin="0,0,-4,0">
                <Button x:Name="ChipsClassic" Style="{StaticResource SegButton}" Content="Classic"
                        ToolTip="Solid colored chips" Click="ChipsClassic_Click"/>
                <Button x:Name="ChipsTint" Style="{StaticResource SegButton}" Content="Tint"
                        ToolTip="Soft tinted chips" Click="ChipsTint_Click"/>
                <Button x:Name="ChipsText" Style="{StaticResource SegButton}" Content="Text"
                        ToolTip="Colored numbers, no chip" Click="ChipsText_Click"/>
            </UniformGrid>
        </Grid>
        <UniformGrid Columns="2" Margin="0,10,-4,0">
            <Button Style="{StaticResource SegButton}" Content="Show / hide preview" Click="Preview_Click"
                    ToolTip="A demo lobby on screen for positioning — works without the game"/>
            <Button Style="{StaticResource SegButton}" Content="Reset position" Click="Reset_Click"
                    ToolTip="Brings the panel back to the top-left corner at its default size"/>
        </UniformGrid>
        <TextBlock FontSize="10.5" Foreground="#FF7D848C" TextWrapping="Wrap" Margin="2,7,0,0"
                   Text="Drag the panel by its header · mouse wheel to zoom"/>

        <Border Height="1" Background="{StaticResource Divider}" Margin="0,12,0,12"/>

        <!-- APP -->
        <CheckBox x:Name="AutostartBox" Content="Start with Windows"
                  Checked="AutostartBox_Changed" Unchecked="AutostartBox_Changed"/>
        <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically"
                  Checked="AutoUpdateBox_Changed" Unchecked="AutoUpdateBox_Changed"/>
        <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
            <Button x:Name="CheckButton" Style="{StaticResource LinkButton}" Content="Check for updates"
                    Click="CheckButton_Click"/>
            <TextBlock Text="  ·  " FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
            <Button Style="{StaticResource LinkButton}" Content="GitHub" Click="GitHub_Click"/>
            <TextBlock Text="  ·  " FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
            <Button Style="{StaticResource LinkButton}" Content="Data folder" Click="DataFolder_Click"/>
        </StackPanel>
        <TextBlock x:Name="CheckResult" FontSize="11" Foreground="{StaticResource TextMuted}"
                   TextWrapping="Wrap" Margin="2,5,0,0" Visibility="Collapsed"/>
    </StackPanel>
</Window>
