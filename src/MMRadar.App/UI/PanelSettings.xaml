<UserControl x:Class="MMRadar.Standalone.PanelSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <!-- The app's own copy of the panel settings. It started as the plugin's
         SettingsContent and is free to diverge: the plugin's file is never edited
         for the app. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F4F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FFAAB0B7"/>
        <SolidColorBrush x:Key="AccentGold" Color="#FFE6C377"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Width="260">
        <TextBlock Text="THEME" FontSize="9.5" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,7"/>
        <UniformGrid Columns="3" Margin="0,0,0,12">
            <Button x:Name="ThemeDarkButton" Style="{StaticResource ThemeButton}" Click="ThemeDark_Click"
                    ToolTip="Solid near-black, maximum contrast">
                <StackPanel>
                    <Border Width="34" Height="18" CornerRadius="4" Background="#FF17181B"
                            BorderBrush="#4DFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                        <Border Width="14" Height="6" CornerRadius="2" Background="#FF3DD08F"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    </Border>
                    <TextBlock Text="Dark" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="ThemeNeutralButton" Style="{StaticResource ThemeButton}" Click="ThemeNeutral_Click"
                    ToolTip="Neutral grey (default)">
                <StackPanel>
                    <Border Width="34" Height="18" CornerRadius="4" Background="#FF262626"
                            BorderBrush="#4DFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                        <Border Width="14" Height="6" CornerRadius="2" Background="#FFCFAF6E"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    </Border>
                    <TextBlock Text="Neutral" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="ThemeWarmButton" Style="{StaticResource ThemeButton}" Click="ThemeWarm_Click"
                    ToolTip="Warm dark with gold, blends with Hearthstone">
                <StackPanel>
                    <Border Width="34" Height="18" CornerRadius="4" Background="#FF191612"
                            BorderBrush="#66DCB97A" BorderThickness="1" HorizontalAlignment="Center">
                        <Border Width="14" Height="6" CornerRadius="2" Background="#FFE3B65C"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    </Border>
                    <TextBlock Text="Warm" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <TextBlock Text="SORT ORDER" FontSize="9.5" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,7"/>
        <UniformGrid Columns="2" Margin="0,0,0,12">
            <Button x:Name="SortDescButton" Style="{StaticResource ThemeButton}" Click="SortDesc_Click"
                    ToolTip="Strongest players at the top (default)">
                <StackPanel>
                    <Border Width="34" Height="18" CornerRadius="4" Background="#FF17181B"
                            BorderBrush="#4DFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="5,0">
                            <Border Height="3" Width="22" CornerRadius="1.5" Background="#FFD9DDE2" HorizontalAlignment="Left"/>
                            <Border Height="3" Width="14" CornerRadius="1.5" Background="#B3AAB0B7" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                            <Border Height="3" Width="8"  CornerRadius="1.5" Background="#66AAB0B7" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Highest first" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="SortAscButton" Style="{StaticResource ThemeButton}" Click="SortAsc_Click"
                    ToolTip="Weakest players at the top, like BGRank">
                <StackPanel>
                    <Border Width="34" Height="18" CornerRadius="4" Background="#FF17181B"
                            BorderBrush="#4DFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="5,0">
                            <Border Height="3" Width="8"  CornerRadius="1.5" Background="#66AAB0B7" HorizontalAlignment="Left"/>
                            <Border Height="3" Width="14" CornerRadius="1.5" Background="#B3AAB0B7" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                            <Border Height="3" Width="22" CornerRadius="1.5" Background="#FFD9DDE2" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Lowest first" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <TextBlock Text="AVG COLORS" FontSize="9.5" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,7"/>
        <UniformGrid Columns="3" Margin="0,0,0,12">
            <Button x:Name="ChipsClassicButton" Style="{StaticResource ThemeButton}" Click="ChipsClassic_Click"
                    ToolTip="Bright solid chips, maximum pop (default)">
                <StackPanel>
                    <Border Width="34" Height="18" CornerRadius="4" Background="#FF17181B"
                            BorderBrush="#4DFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                        <Border Width="22" Height="11" CornerRadius="3" Background="#FF3DD08F"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="2.4" FontSize="7.5" FontWeight="Bold" Foreground="#FF121417"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <TextBlock Text="Classic" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="ChipsTintButton" Style="{StaticResource ThemeButton}" Click="ChipsTint_Click"
                    ToolTip="Soft chips in the panel's own green/red; average results stay neutral">
                <StackPanel>
                    <Border Width="34" Height="18" CornerRadius="4" Background="#FF17181B"
                            BorderBrush="#4DFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                        <Border Width="22" Height="11" CornerRadius="3" Background="#3334C286"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="2.4" FontSize="7.5" FontWeight="Bold" Foreground="#FF34C286"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <TextBlock Text="Tint" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="ChipsBareButton" Style="{StaticResource ThemeButton}" Click="ChipsBare_Click"
                    ToolTip="No chips, just colored numbers like the header delta">
                <StackPanel>
                    <Border Width="34" Height="18" CornerRadius="4" Background="#FF17181B"
                            BorderBrush="#4DFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="2.4" FontSize="9" FontWeight="Bold" Foreground="#FF34C286"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Text" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <TextBlock Text="OVERLAY" FontSize="9.5" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,7"/>
        <!-- Two equal actions side by side; the panel button shows its state
             (gold border + "Hide panel" while the panel is on screen). -->
        <UniformGrid Columns="2" Margin="0,0,0,8">
            <Button x:Name="PanelButton" Style="{StaticResource ThemeButton}" Click="Panel_Click"
                    ToolTip="A test panel filled with a demo lobby (current top-8 players). Place and size it before you play.">
                <TextBlock x:Name="PanelButtonText" Text="Show test panel" FontSize="11.5"/>
            </Button>
            <Button Style="{StaticResource ThemeButton}" Click="Reset_Click"
                    ToolTip="Moves the panel back to the top-left corner and resets its size">
                <TextBlock Text="Reset position" FontSize="11.5"/>
            </Button>
        </UniformGrid>
        <TextBlock Margin="2,0,0,0" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                   TextWrapping="Wrap"
                   Text="Drag the panel header to move it · scroll to zoom"/>
    </StackPanel>
</UserControl>
