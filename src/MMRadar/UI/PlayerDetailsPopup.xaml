<UserControl x:Class="MMRadar.UI.PlayerDetailsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             FontFamily="Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <!-- Like LobbyPanel, zooming scales fonts/metrics (ApplyLayoutScale) instead of
         using a RenderTransform, so text stays crisp at every zoom level. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="PopupWidth">280</sys:Double>
            <sys:Double x:Key="PNameFont">15</sys:Double>
            <sys:Double x:Key="PSubFont">11</sys:Double>
            <sys:Double x:Key="PStatusFont">12</sys:Double>
            <sys:Double x:Key="PCapFont">9.5</sys:Double>
            <sys:Double x:Key="PBigCapFont">10</sys:Double>
            <sys:Double x:Key="PBigFont">22</sys:Double>
            <sys:Double x:Key="PValFont">12.5</sys:Double>
            <sys:Double x:Key="PGameFont">12</sys:Double>
            <sys:Double x:Key="PGameChipFont">11.5</sys:Double>
            <sys:Double x:Key="PChartHeight">36</sys:Double>
            <sys:Double x:Key="PBadgeFont">10</sys:Double>
            <GridLength x:Key="PColTime">80</GridLength>
            <GridLength x:Key="PColChip">36</GridLength>
            <GridLength x:Key="PColDelta">52</GridLength>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Width="{DynamicResource PopupWidth}"
            CornerRadius="12"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.25" Color="#FF000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Border x:Name="Header"
                    Background="Transparent"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp"
                    MouseMove="Header_MouseMove"
                    LostMouseCapture="Header_LostMouseCapture">
                <Grid Margin="12,7,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NameText" FontSize="{DynamicResource PNameFont}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                            <StackPanel x:Name="LivePanel" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="6,1,0,0"
                                        Visibility="Collapsed">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource LiveRed}"/>
                                <TextBlock Text="live" FontSize="{DynamicResource PBadgeFont}" FontWeight="SemiBold"
                                           Foreground="{StaticResource LiveRed}" Margin="3,-2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="SubText" FontSize="{DynamicResource PSubFont}"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="1" VerticalAlignment="Top"
                            Style="{StaticResource IconButton}" Content="✕"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Status (loading / error) -->
            <TextBlock x:Name="StatusText" Margin="12,10,12,12" FontSize="{DynamicResource PStatusFont}"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <StackPanel x:Name="ContentPanel">
                <!-- MMR trajectory over the games listed below -->
                <StackPanel x:Name="ChartBlock" Margin="12,8,12,0">
                    <DockPanel LastChildFill="False" Margin="6,0,6,3">
                        <TextBlock x:Name="ChartCaption" DockPanel.Dock="Left"
                                   Text="MMR · LAST 10 GAMES"
                                   FontSize="{DynamicResource PCapFont}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="ChartDeltaText" DockPanel.Dock="Right"
                                   FontSize="{DynamicResource PSubFont}" FontWeight="SemiBold"
                                   Foreground="{StaticResource PositiveGreen}"/>
                    </DockPanel>
                    <Grid Height="{DynamicResource PChartHeight}" ClipToBounds="True">
                        <Canvas x:Name="SparklineCanvas" Background="Transparent"
                                SizeChanged="SparklineCanvas_SizeChanged"/>
                    </Grid>
                    <DockPanel LastChildFill="False" Margin="6,2,6,0">
                        <TextBlock x:Name="ChartFromText" DockPanel.Dock="Left"
                                   FontSize="{DynamicResource PCapFont}" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="ChartToText" DockPanel.Dock="Right"
                                   FontSize="{DynamicResource PCapFont}" Foreground="{DynamicResource TextMuted}"/>
                    </DockPanel>
                </StackPanel>

                <!-- Big average -->
                <Border Margin="8,8,8,0" CornerRadius="8"
                        Background="{DynamicResource SubtleFill}" Padding="10,6">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="AvgCaption" DockPanel.Dock="Left"
                                   Text="AVG PLACE · LAST 10"
                                   FontSize="{DynamicResource PBigCapFont}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="BigAvgText" DockPanel.Dock="Right"
                                   FontSize="{DynamicResource PBigFont}" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PositiveGreen}"/>
                    </DockPanel>
                </Border>

                <!-- Day / week -->
                <Grid Margin="18,7,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TODAY" FontSize="{DynamicResource PCapFont}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="DayStatText" FontSize="{DynamicResource PValFont}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LAST 7 DAYS" FontSize="{DynamicResource PCapFont}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="WeekStatText" FontSize="{DynamicResource PValFont}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Grid>

                <!-- Recent games -->
                <TextBlock Text="RECENT GAMES" Margin="18,9,18,1"
                           FontSize="{DynamicResource PCapFont}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"/>
                <TextBlock x:Name="NoGamesText" Margin="18,2,18,6" FontSize="{DynamicResource PSubFont}"
                           Foreground="{DynamicResource TextMuted}"
                           Text="no recent rating changes detected"
                           Visibility="Collapsed"/>
                <ItemsControl x:Name="GamesControl" Margin="12,0,12,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,2.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{DynamicResource PColTime}"/>
                                    <ColumnDefinition Width="{DynamicResource PColChip}"/>
                                    <ColumnDefinition Width="{DynamicResource PColDelta}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                           FontSize="{DynamicResource PGameFont}" Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="3"
                                        Background="{DynamicResource ChipBackground}" Padding="0,0.5"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlacementText}"
                                               FontSize="{DynamicResource PGameChipFont}" FontWeight="Bold"
                                               Foreground="{Binding PlacementBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <!-- Ideal formatting keeps the digit columns uniform
                                     across rows (see the note in LobbyPanel.xaml). -->
                                <TextBlock Grid.Column="2" Text="{Binding DeltaText}"
                                           TextOptions.TextFormattingMode="Ideal"
                                           FontSize="{DynamicResource PGameFont}" FontWeight="SemiBold"
                                           Foreground="{Binding DeltaBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding MmrText}"
                                           TextOptions.TextFormattingMode="Ideal"
                                           FontSize="{DynamicResource PGameFont}" Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
