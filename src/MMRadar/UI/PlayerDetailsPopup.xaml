<UserControl x:Class="MMRadar.UI.PlayerDetailsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- See LobbyPanel.xaml: the scale must be on the registered element for HDT hit-testing. -->
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Width="272"
            CornerRadius="12"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.25" Color="#FF000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Border x:Name="Header"
                    Background="Transparent"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp"
                    MouseMove="Header_MouseMove"
                    LostMouseCapture="Header_LostMouseCapture">
                <Grid Margin="12,7,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NameText" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                            <StackPanel x:Name="LivePanel" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="6,1,0,0"
                                        Visibility="Collapsed">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource LiveRed}"/>
                                <TextBlock Text="live" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource LiveRed}" Margin="3,-2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="SubText" FontSize="10"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="1" VerticalAlignment="Top"
                            Style="{StaticResource IconButton}" Content="✕"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Status (loading / error) -->
            <TextBlock x:Name="StatusText" Margin="12,10,12,12" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <StackPanel x:Name="ContentPanel">
                <!-- MMR trajectory over the games listed below -->
                <StackPanel x:Name="ChartBlock" Margin="12,8,12,0">
                    <DockPanel LastChildFill="False" Margin="6,0,6,3">
                        <TextBlock x:Name="ChartCaption" DockPanel.Dock="Left"
                                   Text="MMR · LAST 10 GAMES"
                                   FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="ChartDeltaText" DockPanel.Dock="Right"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource PositiveGreen}"/>
                    </DockPanel>
                    <Grid Height="34" ClipToBounds="True">
                        <Canvas x:Name="SparklineCanvas" Background="Transparent"
                                SizeChanged="SparklineCanvas_SizeChanged"/>
                    </Grid>
                    <DockPanel LastChildFill="False" Margin="6,2,6,0">
                        <TextBlock x:Name="ChartFromText" DockPanel.Dock="Left"
                                   FontSize="8.5" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="ChartToText" DockPanel.Dock="Right"
                                   FontSize="8.5" Foreground="{DynamicResource TextMuted}"/>
                    </DockPanel>
                </StackPanel>

                <!-- Big average -->
                <Border Margin="8,8,8,0" CornerRadius="8"
                        Background="{DynamicResource SubtleFill}" Padding="10,6">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="AvgCaption" DockPanel.Dock="Left"
                                   Text="AVG PLACE · LAST 10"
                                   FontSize="9" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="BigAvgText" DockPanel.Dock="Right"
                                   FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PositiveGreen}"/>
                    </DockPanel>
                </Border>

                <!-- Day / week -->
                <Grid Margin="18,7,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TODAY" FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="DayStatText" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LAST 7 DAYS" FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="WeekStatText" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Grid>

                <!-- Recent games -->
                <TextBlock Text="RECENT GAMES" Margin="18,9,18,1"
                           FontSize="8.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"/>
                <TextBlock x:Name="NoGamesText" Margin="18,2,18,6" FontSize="10.5"
                           Foreground="{DynamicResource TextMuted}"
                           Text="no recent rating changes detected"
                           Visibility="Collapsed"/>
                <ItemsControl x:Name="GamesControl" Margin="12,0,12,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                           FontSize="10" Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="3"
                                        Background="{DynamicResource ChipBackground}" Padding="0,0.5"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlacementText}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding PlacementBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding DeltaText}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding DeltaBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding MmrText}"
                                           FontSize="10.5" Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
