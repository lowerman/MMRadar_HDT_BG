<UserControl x:Class="MMRadar.UI.LobbyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             FontFamily="Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <!-- Zooming is done by scaling FONT SIZES (see ApplyLayoutScale), not with a
         RenderTransform: transformed text loses ClearType and gets blurry, while
         re-rendered text stays crisp at every zoom level. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="RowFontSize">16</sys:Double>
            <sys:Double x:Key="ChipFontSize">13.5</sys:Double>
            <sys:Double x:Key="RowHeight">24</sys:Double>
            <sys:Double x:Key="NameMaxWidth">150</sys:Double>
            <sys:Double x:Key="BadgeFontSize">10.5</sys:Double>
            <sys:Double x:Key="MarkFontSize">12</sys:Double>
            <sys:Double x:Key="DotSize">6</sys:Double>
            <sys:Double x:Key="TitleFontSize">11</sys:Double>
            <sys:Double x:Key="CtxFontSize">11</sys:Double>
            <sys:Double x:Key="StatusFontSize">11.5</sys:Double>
            <sys:Double x:Key="HeaderBtnSize">18</sys:Double>
            <sys:Double x:Key="HeaderBtnFont">10</sys:Double>
            <sys:Double x:Key="HeaderGearFont">11</sys:Double>
            <GridLength x:Key="ChipColWidth">52</GridLength>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Auto-width: the card hugs its content like BGRank instead of a fixed size -->
    <Border x:Name="RootBorder"
            MinWidth="192"
            CornerRadius="12"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.25" Color="#FF000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header: drag area + zoom -->
            <Border x:Name="Header"
                    Background="Transparent"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp"
                    MouseMove="Header_MouseMove"
                    MouseLeave="Header_MouseLeave"
                    LostMouseCapture="Header_LostMouseCapture"
                    MouseWheel="Header_MouseWheel">
                <DockPanel Margin="12,6,6,5" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="MMR" FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="TitleRankPart" Text="ADAR" FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <Ellipse Width="4" Height="4" Margin="5,1,0,0"
                                 Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- The gear lives NEXT TO THE TITLE, at the opposite end from
                         the collapse button: aiming at "–" can never hit it, and the
                         header stays short enough to fit the body width. -->
                    <Button x:Name="SettingsButton" DockPanel.Dock="Left"
                            Style="{StaticResource IconButton}"
                            Width="{DynamicResource HeaderBtnSize}" Height="{DynamicResource HeaderBtnSize}"
                            FontSize="{DynamicResource HeaderGearFont}"
                            Content="⚙" Margin="6,0,0,0" VerticalAlignment="Center"
                            Click="SettingsButton_Click"
                            ToolTip="Settings — theme, sort order, preview"/>
                    <Button x:Name="CollapseButton" DockPanel.Dock="Right"
                            Style="{StaticResource IconButton}"
                            Width="{DynamicResource HeaderBtnSize}" Height="{DynamicResource HeaderBtnSize}"
                            FontSize="{DynamicResource HeaderBtnFont}"
                            Content="–" Click="CollapseButton_Click"
                            ToolTip="Collapse into a small pill"/>
                    <!-- lobby average + your delta live in the header to save a row.
                         The LEFT margin is the guaranteed gap to the gear: when the
                         header is the widest element of the card there is no slack
                         space, and without it the text would glue to its neighbor. -->
                    <TextBlock x:Name="HeaderContextText" DockPanel.Dock="Right"
                               FontSize="{DynamicResource CtxFontSize}"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" Margin="8,0,8,0"
                               Visibility="Collapsed"/>
                </DockPanel>
            </Border>

            <!-- Body -->
            <StackPanel x:Name="Body">
                <TextBlock x:Name="StatusText"
                           Margin="12,8,12,8"
                           FontSize="{DynamicResource StatusFontSize}"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="Waiting for lobby…"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="RowsControl" Margin="0,3" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}"
                                    Click="Row_Click"
                                    Tag="{Binding}"
                                    Cursor="Hand"
                                    ToolTip="{Binding TooltipText}"
                                    Background="{Binding RowBackground}"
                                    Opacity="{Binding RowOpacity}">
                                <!-- HUD typography; shared-size columns keep every row
                                     aligned while the panel hugs its content. -->
                                <Grid Margin="10,0,8,0" Height="{DynamicResource RowHeight}">
                                    <Grid.ColumnDefinitions>
                                        <!-- Star column: when the HEADER is the widest
                                             element (long avg text), rows stretch to the
                                             card width and the slack dissolves between
                                             name and rating instead of leaving a dead
                                             strip right of the chips. -->
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PlayerRating"/>
                                        <ColumnDefinition Width="{DynamicResource ChipColWidth}"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- name + markers -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{DynamicResource RowFontSize}" FontWeight="SemiBold"
                                                   Foreground="{Binding NameBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="{DynamicResource NameMaxWidth}"/>
                                        <Ellipse Width="{DynamicResource DotSize}" Height="{DynamicResource DotSize}"
                                                 Fill="{StaticResource LiveRed}"
                                                 Visibility="{Binding LiveVisibility}"
                                                 Margin="5,1,0,0" VerticalAlignment="Center"
                                                 ToolTip="Streaming live"/>
                                        <TextBlock Text="☠" FontSize="{DynamicResource MarkFontSize}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding DeadVisibility}"/>
                                    </StackPanel>

                                    <!-- rating: same size and contrast as the name.
                                         Ideal formatting: Display-mode hinting gives
                                         Segoe UI a narrower "1" at some sizes, which
                                         breaks the digit columns across rows. -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RatingText}"
                                               TextOptions.TextFormattingMode="Ideal"
                                               FontSize="{DynamicResource RowFontSize}" FontWeight="SemiBold"
                                               Foreground="{Binding RatingBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,8,0"/>

                                    <!-- avg placement chip -->
                                    <Border Grid.Column="2"
                                            Visibility="{Binding AvgVisibility}"
                                            Background="{Binding AvgBrush}"
                                            CornerRadius="4" Padding="0,2.5"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding AvgText}"
                                                   FontSize="{DynamicResource ChipFontSize}" FontWeight="Bold"
                                                   Foreground="{Binding AvgTextBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2"
                                               Visibility="{Binding NoDataVisibility}"
                                               Text="–" FontSize="{DynamicResource ChipFontSize}"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
