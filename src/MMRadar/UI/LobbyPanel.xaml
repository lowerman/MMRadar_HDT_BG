<UserControl x:Class="MMRadar.UI.LobbyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- The scale must live on the UserControl itself: HDT's overlay hit-testing only
         accounts for transforms on the registered element and its ancestors. -->
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Width="272"
            CornerRadius="12"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.25" Color="#FF000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header: drag area + zoom -->
            <Border x:Name="Header"
                    Background="Transparent"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp"
                    MouseMove="Header_MouseMove"
                    MouseLeave="Header_MouseLeave"
                    LostMouseCapture="Header_LostMouseCapture"
                    MouseWheel="Header_MouseWheel">
                <DockPanel Margin="12,6,6,5" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="MMR" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="TitleRankPart" Text="ADAR" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <Ellipse Width="4" Height="4" Margin="5,1,0,0"
                                 Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CollapseButton" DockPanel.Dock="Right"
                            Style="{StaticResource IconButton}"
                            Content="–" Click="CollapseButton_Click"
                            ToolTip="Collapse into a small pill"/>
                </DockPanel>
            </Border>

            <!-- Body -->
            <StackPanel x:Name="Body">
                <TextBlock x:Name="StatusText"
                           Margin="12,8,12,8"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="Waiting for lobby…"
                           Visibility="Collapsed"/>

                <!-- One-line lobby context: average strength and your delta to it -->
                <TextBlock x:Name="LobbyContextText"
                           Margin="12,5,12,0"
                           FontSize="9.5"
                           Foreground="{DynamicResource TextMuted}"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="RowsControl" Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}"
                                    Click="Row_Click"
                                    Tag="{Binding}"
                                    Cursor="Hand"
                                    ToolTip="{Binding TooltipText}"
                                    Opacity="{Binding RowOpacity}">
                                <Grid Margin="8,0" Height="25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- wallii leaderboard rank -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding RankText}"
                                               Visibility="{Binding RankVisibility}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding RankBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- name + markers -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="118"/>
                                        <TextBlock Text="you"
                                                   Visibility="{Binding LocalChipVisibility}"
                                                   FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        <Ellipse Width="5" Height="5"
                                                 Fill="{StaticResource LiveRed}"
                                                 Visibility="{Binding LiveVisibility}"
                                                 Margin="5,1,0,0" VerticalAlignment="Center"
                                                 ToolTip="Streaming live"/>
                                        <TextBlock Text="☠" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding DeadVisibility}"/>
                                    </StackPanel>

                                    <!-- rating: slightly brighter and heavier than body text -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RatingText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource RatingBrush}"
                                               VerticalAlignment="Center"
                                               Margin="6,0"/>

                                    <!-- avg placement chip -->
                                    <Border Grid.Column="3"
                                            Visibility="{Binding AvgVisibility}"
                                            Background="{Binding AvgBrush}"
                                            CornerRadius="4" Padding="0,1.5"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding AvgText}"
                                                   FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{Binding AvgTextBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="3"
                                               Visibility="{Binding NoDataVisibility}"
                                               Text="–" FontSize="10.5"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
