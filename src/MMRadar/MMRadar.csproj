<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MMRadar</AssemblyName>
    <RootNamespace>MMRadar</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.4</Version>
    <Company>MMRadar</Company>
    <Product>MMRadar</Product>
    <Description>Hearthstone Deck Tracker Battlegrounds plugin: lobby ratings + wallii.gg player stats</Description>
    <!-- Directory that contains HearthstoneDeckTracker.exe and its DLLs.
         Auto-detected by tools/build.ps1; override with -p:HdtDir=... -->
    <HdtDir Condition="'$(HdtDir)' == ''">$(LOCALAPPDATA)\HearthstoneDeckTracker\app-1.53.8</HdtDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Allows building without a Visual Studio .NET Framework targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtDir)\HearthstoneDeckTracker.exe</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HdtDir)\HearthMirror.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtDir)\HearthDb.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HdtDir)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MahApps.Metro">
      <HintPath>$(HdtDir)\MahApps.Metro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <Target Name="EnsureHdtDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(HdtDir)\HearthstoneDeckTracker.exe')"
           Text="HearthstoneDeckTracker.exe not found in '$(HdtDir)'. Pass -p:HdtDir=&lt;path to HDT app-x.y.z folder&gt; or run tools/build.ps1 which auto-detects it." />
  </Target>

</Project>
